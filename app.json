{
  "expo": {
    "name": "PhotoJournal",
    "slug": "photo-journal-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3d3c49"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dffamrn.photojournalapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.juan.photojournalapp",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PhotoJournal membutuhkan akses galeri untuk melampirkan foto ke jurnal.",
          "cameraPermission": "PhotoJournal membutuhkan kamera untuk mengambil foto langsung."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PhotoJournal menggunakan lokasi hanya saat app aktif untuk mencatat tempat di jurnal."
        }
      ]
    ],
    "owner": "juantambunan",
    "extra": {
      "eas": {
        "projectId": "56e2cd7a-58e9-407d-9c0f-8b4f3040d58b"
      }
    }
  }
}
